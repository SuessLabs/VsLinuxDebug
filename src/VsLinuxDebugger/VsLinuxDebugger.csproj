  <!-- To modify your build process, add your task inside one of the targets below and uncomment it. 
       Other similar extension points exist, see Microsoft.Common.targets.
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
  -->
  <!-- Download PLink.exe to package with project -->
  <PropertyGroup>
    <PLinkUrl>https://the.earth.li/~sgtatham/putty/latest/w64/plink.exe</PLinkUrl>
  </PropertyGroup>
  <Target Name="DownloadContentFiles" BeforeTargets="Build">
    <DownloadFile SourceUrl="$(PLinkUrl)" DestinationFolder="$(MSBuildProjectDirectory)">
      <Output TaskParameter="DownloadedFile" ItemName="Content" />
    </DownloadFile>
  </Target>

  <!-- Exposes $(VsixVersion) to source.extension.vsixmanifest, referenced there as
       Version="|%CurrentProject%;GetVsixVersion|". Keeps the version in one place
       (this project's $(VsixVersion) property) instead of duplicated in the manifest. -->
  <Target Name="GetVsixVersion" Outputs="$(VsixVersion)" />

  <!-- Generates AssemblyVersionInfo.cs from $(VsixVersion) before every compile, so
       AssemblyVersion/AssemblyFileVersion never need editing by hand alongside the
       manifest. Both come from the same $(VsixVersion) property above. -->
  <Target Name="GenerateAssemblyVersionInfo" BeforeTargets="CoreCompile">
    <ItemGroup>
      <AssemblyVersionInfoLines Include="// Auto-generated by the GenerateAssemblyVersionInfo MSBuild target." />
      <AssemblyVersionInfoLines Include="// Do not edit by hand. Change VsixVersion in VsLinuxDebugger.csproj instead." />
      <AssemblyVersionInfoLines Include="using System.Reflection%3B" />
      <AssemblyVersionInfoLines Include=" " />
      <AssemblyVersionInfoLines Include="[assembly: AssemblyVersion(&quot;$(VsixVersion).0&quot;)]" />
      <AssemblyVersionInfoLines Include="[assembly: AssemblyFileVersion(&quot;$(VsixVersion).0&quot;)]" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(IntermediateOutputPath)AssemblyVersionInfo.cs"
      Lines="@(AssemblyVersionInfoLines)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)AssemblyVersionInfo.cs" />
      <FileWrites Include="$(IntermediateOutputPath)AssemblyVersionInfo.cs" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Content Include="plink.exe" Condition="Exists('plink.exe')">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
