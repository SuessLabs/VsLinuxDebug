<UserControl x:Class="Xeno.VsLinuxDebug.OptionsPages.RemoteCredentialsOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Xeno.VsLinuxDebug.OptionsPages"
             mc:Ignorable="d">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="OptionsPageStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
      <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel Style="{StaticResource PageRootStyle}">
    <GroupBox Header="Remote Credentials" Style="{StaticResource OptionsGroupBoxStyle}">
      <StackPanel>

        <StackPanel Style="{StaticResource FieldRowStyle}">
          <Label Content="User Name" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
          <TextBlock Style="{StaticResource FieldHelpTextStyle}"
                     Text="SSH User name on remote machine." />
        </StackPanel>

        <StackPanel Style="{StaticResource FieldRowStyle}">
          <CheckBox Content="SSH Key File Enabled"
                     IsChecked="{Binding UserPrivateKeyEnabled}"
                     Style="{StaticResource FieldCheckBoxStyle}" />
          <TextBlock Style="{StaticResource FieldHelpTextStyle}"
                     Text="Use an SSH private key instead of a password. PLINK only accepts '.ppk' keys, not this OpenSSH-format one, so the debugger connection needs 'Use SSH.exe' enabled (Options &gt; Local) to use it." />
        </StackPanel>

        <!-- Password row: visible only when UserPrivateKeyEnabled == false. Collapsed
             (not just hidden) so the layout doesn't leave a gap. -->
        <StackPanel Style="{StaticResource FieldRowStyle}"
                    Visibility="{Binding UserPrivateKeyEnabled, Converter={StaticResource InverseBoolToVisibility}}">
          <Label Content="User Password" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding UserPass, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
          <TextBlock Style="{StaticResource FieldHelpTextStyle}"
                     Text="SSH Password on remote machine." />
        </StackPanel>

        <!-- Private-key rows: visible only when UserPrivateKeyEnabled == true. -->
        <StackPanel Style="{StaticResource FieldRowStyle}"
                    Visibility="{Binding UserPrivateKeyEnabled, Converter={StaticResource BoolToVisibility}}">
          <Label Content="SSH Private Key File (optional)" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding UserPrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
          <TextBlock Style="{StaticResource FieldHelpTextStyle}"
                     Text="Path to an OpenSSH-format private key file." />
        </StackPanel>

        <StackPanel Style="{StaticResource FieldRowStyle}"
                    Visibility="{Binding UserPrivateKeyEnabled, Converter={StaticResource BoolToVisibility}}">
          <Label Content="SSH Private Key Password (optional)" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding UserPrivateKeyPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
          <TextBlock Style="{StaticResource FieldHelpTextStyle}"
                     Text="Private key password (only if it was set)." />
        </StackPanel>

        <StackPanel Style="{StaticResource FieldRowStyle}"
                    Visibility="{Binding UserPrivateKeyEnabled, Converter={StaticResource BoolToVisibility}}">
          <Label Content="SSH Certificate File (optional)" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding UserCertificatePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBoxStyle}" />
          <TextBlock Style="{StaticResource FieldHelpTextStyle}"
                     Text="Path to a CA-signed '&lt;key&gt;-cert.pub' certificate. Leave blank to auto-detect it next to the private key." />
        </StackPanel>

        <TextBlock Style="{StaticResource FieldHelpTextStyle}" Margin="0,0,0,10"
                   Text="Whether the debugger connects via SSH.exe or PLINK (and PLINK's local path) is set in Options &gt; Local." />

      </StackPanel>
    </GroupBox>
  </StackPanel>
</UserControl>
