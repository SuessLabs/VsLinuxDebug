<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shared layout constants/styles for the six Options pages, so they read as one
       consistent flat form (label above control, consistent spacing, no PropertyGrid-style
       dense table, no collapsible sections). -->

  <Style x:Key="OptionsGroupBoxStyle" TargetType="GroupBox">
    <Setter Property="Margin" Value="0,0,0,16" />
    <Setter Property="Padding" Value="10,8,10,10" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="FieldRowStyle" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Vertical" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <Style x:Key="FieldLabelStyle" TargetType="Label">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
    <Setter Property="Padding" Value="3,2" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- For multi-line fields (env vars, pre/post-deploy commands): text starts at the
       top-left instead of being vertically centered in the box. -->
  <Style x:Key="FieldMultilineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FieldTextBoxStyle}">
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Height" Value="70" />
  </Style>

  <Style x:Key="FieldCheckBoxStyle" TargetType="CheckBox">
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="FieldHelpTextStyle" TargetType="TextBlock">
    <Setter Property="Margin" Value="0,3,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Opacity" Value="0.65" />
    <Setter Property="FontStyle" Value="Italic" />
  </Style>

  <Style x:Key="PageRootStyle" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Vertical" />
    <Setter Property="Margin" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

</ResourceDictionary>
